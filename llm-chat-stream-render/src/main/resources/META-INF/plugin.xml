<idea-plugin>
    <id>cn.lacknb.blog.llm.chat.stream.render</id>
    <name>llm-chat-stream-render</name>
    <version>1.0.1</version>
    <vendor email="gitsilence@gmail.com" url="https://blog.lacknb.cn">gitsilence</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <codeInsight.lineMarkerProvider language="JAVA"
                                        implementationClass="cn.lacknb.blog.llm.stream.MethodActionLineMarkerProvider"/>
        <toolWindow id="LLM Chat Stream" anchor="right"
                    factoryClass="cn.lacknb.blog.llm.stream.LLMChatToolWindowFactory"/>
        <postStartupActivity implementation="cn.lacknb.blog.llm.stream.AuthStartupActivity"/>
        <statusBarWidgetFactory id="llm.chat.auth.status"
                                implementation="cn.lacknb.blog.llm.stream.MyStatusBarWidgetFactory"/>
        <projectService serviceImplementation="cn.lacknb.blog.llm.stream.ChatSettingsState"/>
        <projectService serviceImplementation="cn.lacknb.blog.llm.stream.MyAuthService"/>
        <projectService serviceImplementation="cn.lacknb.blog.llm.stream.OAuthLoginService"/>
        <projectConfigurable
                parentId="tools"
                instance="cn.lacknb.blog.llm.stream.ChatSettingsConfigurable"
                id="cn.lacknb.blog.llm.stream.ChatSettings"
                displayName="ChatSettings"
                nonDefaultProject="true"/>
    </extensions>
</idea-plugin>
